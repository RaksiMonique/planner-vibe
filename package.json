{
  "name": "planner-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:dev": "dotenv -e .env.local.dev -- next dev",
    "dev:login": "dotenv -e .env.local.dev -- node scripts/dev-login.mjs",
    "dev:password": "dotenv -e .env.local.dev -- node scripts/set-password.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "dotenv -e .env.test.local -- playwright test",
    "e2e:smoke": "dotenv -e .env.test.local -- playwright test --grep @smoke",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:dev": "drizzle-kit migrate --config=drizzle.config.dev.ts",
    "db:push:PROD-DANGEROUS": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:studio:dev": "drizzle-kit studio --config=drizzle.config.dev.ts",
    "db:seed": "dotenv -e .env.test.local -- tsx src/db/seed.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fullcalendar/react": "^7.1.4",
    "@hookform/resolvers": "^7.0.3",
    "@sentry/nextjs": "^11.11.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@types/web-push": "3.6.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "postgres": "^4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "rrule": "^2.8.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "temporal-polyfill": "^1.0.8",
    "tw-animate-css": "^1.4.0",
    "web-push": "4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "vitest": "^5.1.0"
  }
}
