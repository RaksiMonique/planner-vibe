# Production is the planner's own Supabase project in its own organisation.
# Development is the local Docker stack (`npx supabase start`). Nothing is
# shared with any other application (docs/decisions/0002).
#
#   .env.local       production project (used by `npm run dev`, `npm run build`,
#                    `npm run db:migrate` and `npm run db:push:PROD-DANGEROUS`)
#   .env.local.dev   hosted dev project (used by `npm run dev:dev`,
#                    `npm run db:push:dev`, `npm run db:studio:dev`)
#   .env.test.local  local Docker stack (used by `npm run e2e` and `npm run db:seed`;
#                    tests write freely, so never point it at a hosted project)
#
# Both files are git-ignored. Day to day, work with `npm run dev:dev`.

# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres (Settings > Database). Pooler in transaction mode for the app,
# direct (session) connection for drizzle-kit migrations.
DATABASE_URL=postgresql://postgres.PROJECT:secret@aws-0-REGION.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.PROJECT:secret@aws-0-REGION.pooler.supabase.com:5432/postgres

# Public site URL, used for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional
NEXT_PUBLIC_SENTRY_DSN=
RESEND_API_KEY=
CRON_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Auth user id that `npm run db:seed` writes sample data for (dev project)
SEED_USER_ID=
# Emails approved automatically (comma-separated); the first of them becomes the
# owner. Everyone else waits on the Members page until the owner approves them.
# If unset, the first account to sign in becomes the owner.
AUTH_ALLOWED_EMAILS=
# 'true' shows the Google button on the login page (configure the provider in Supabase first)
AUTH_GOOGLE=

# ---- Release 6 integrations (all optional; each feature stays off until its keys exist) ----
# Email reminders and the daily digest through Resend: API key plus a verified sender.
RESEND_API_KEY=
EMAIL_FROM="Life Planner <planner@your-domain.example>"
# Bearer secret the cron routes expect (Vercel sends it for scheduled jobs; an external
# scheduler must send "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=
# Encrypts OAuth tokens at rest and signs OAuth state. Any 32+ character random string.
TOKEN_ENCRYPTION_KEY=
# Google Calendar sync: an OAuth client (Web application) with the redirect URI
# <NEXT_PUBLIC_SITE_URL>/api/google/callback and the Google Calendar API enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Browser push: generate once with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
