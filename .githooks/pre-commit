#!/bin/sh
# Blocks commits that contain .env files or common secret patterns.

FAILED=0

# ── 1. Block staged .env files (anything matching .env* except *.example) ─────
ENV_FILES=$(git diff --cached --name-only | grep -E '(^|/)\.env' | grep -v '\.example$')
if [ -n "$ENV_FILES" ]; then
  echo ""
  echo "❌ Commit blocked: staged .env file(s) detected:"
  echo "$ENV_FILES" | sed 's/^/   /'
  echo ""
  echo "   Remove them with: git reset HEAD <file>"
  FAILED=1
fi

# ── 2. Scan staged content for secret patterns ────────────────────────────────
STAGED_DIFF=$(git diff --cached --unified=0)

# Patterns: Supabase service role / anon JWTs, common key prefixes
SECRET_HITS=$(echo "$STAGED_DIFF" \
  | grep '^+' \
  | grep -v '^+++' \
  | grep -E \
    'sb_secret_[A-Za-z0-9_-]{20,}|sb_publishable_[A-Za-z0-9_-]{20,}|re_[A-Za-z0-9]{20,}|eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\.[A-Za-z0-9_-]+|AAAA[A-Za-z0-9_-]{20,}|postgresql://[^:]+:[^@]{8,}@')

if [ -n "$SECRET_HITS" ]; then
  echo ""
  echo "❌ Commit blocked: possible secret values detected in staged changes."
  echo ""
  echo "$SECRET_HITS" | head -5 | sed 's/^/   /'
  echo ""
  echo "   If this is a false positive, use: git commit --no-verify"
  FAILED=1
fi

[ $FAILED -eq 1 ] && exit 1
echo "✅ Secret scan passed."
exit 0
